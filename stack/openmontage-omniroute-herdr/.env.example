# ============================================================================
# OpenMontage + OmniRoute + Herdr — конфигурация стека
# Скопируй в .env (рядом с этим файлом) и заполни. Секреты в git НЕ коммитим.
#   cp .env.example .env
# ============================================================================

# --- Где живут клоны и окружения (ВНЕ git-репозитория офиса) ---
# Всё воспроизводимо: клоны, venv, node_modules — эфемерны, пересоздаются скриптами.
STACK_DIR="$HOME/ai-office-stack"

# --- Git-ссылки компонентов (можно закрепить на теге/коммите для воспроизводимости) ---
OPENMONTAGE_REPO="https://github.com/calesthio/OpenMontage"
OPENMONTAGE_REF="main"                 # валидировано на 08e2151
OMNIROUTE_REPO="https://github.com/diegosouzapw/OmniRoute"
OMNIROUTE_REF="release/v3.8.51"        # валидировано на 7a921299
HERDR_REPO="https://github.com/herdrdev/herdr"
HERDR_REF="master"                     # валидировано на 3602c75

# --- OmniRoute (локальный proxy-роутер) ---
OMNIROUTE_PORT="20128"
OMNIROUTE_BASE_URL="http://localhost:20128"
# Способ установки: "npm" (npm i -g omniroute, рекомендуется) или "source" (сборка из клона)
OMNIROUTE_INSTALL="npm"

# --- Связка OpenMontage → роутер (через Claude Code) ---
# Модель/комбо, которым OmniRoute отвечает Claude Code. "auto" — работает без ключей.
# Примеры: auto | anthropic/claude-sonnet-4 | google/gemini-2.5-pro
OM_MODEL="auto"
# Ключ, которым Claude Code авторизуется В OmniRoute (не у провайдера).
# Оставь пустым для дефолтного локального ключа OmniRoute; задай, если включил auth на роутере.
OMNIROUTE_API_KEY=""

# --- Herdr (фоновая терминальная среда) ---
HERDR_INSTALL="script"                 # "script" (герд.dev/install.sh) или "cargo" (сборка из клона)
HERDR_SESSION_NAME="openmontage"

# ============================================================================
# КЛЮЧИ ПРОВАЙДЕРОВ ДЛЯ OmniRoute (резервные API для Claude Code)
# ----------------------------------------------------------------------------
# OmniRoute хранит ключи в своём зашифрованном локальном хранилище — эти строки
# нужны только чтобы 03-omniroute-up.sh мог их туда завести автоматически.
# Заполняй только то, что реально используешь. Пусто = провайдер не подключён.
# ВНИМАНИЕ по egress облачного окружения (проверено 2026-09-21):
#   api.anthropic.com          — доступен
#   generativelanguage (Gemini)— доступен
#   api.openai.com             — ЗАБЛОКИРОВАН политикой окружения (CONNECT 403)
#   openrouter.ai              — ЗАБЛОКИРОВАН
# На своей машине доступны все — там комбо раскрывается полностью.
# ============================================================================
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
