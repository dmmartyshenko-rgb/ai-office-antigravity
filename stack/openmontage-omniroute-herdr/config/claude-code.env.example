# Env для Claude Code, направляющий его на локальный OmniRoute.
# Используется как ЗАПАСНОЙ ручной способ связки (основной — `omniroute run claude`,
# который выставляет эти переменные сам). Подставь порт/ключ и `source` перед `claude`.
#
# Claude Code читает ANTHROPIC_BASE_URL и ходит на <base>/v1/messages;
# OmniRoute принимает Anthropic-совместимые запросы и маршрутизирует их по комбо.

export ANTHROPIC_BASE_URL="http://localhost:20128"
# Ключ авторизации В OmniRoute (не у провайдера). Пусто = дефолтный локальный доступ.
export ANTHROPIC_AUTH_TOKEN="omniroute"
# Модель/комбо, которым отвечает роутер (auto = без ключей из коробки).
export ANTHROPIC_MODEL="auto"
# Небольшая модель для вспомогательных вызовов Claude Code.
export ANTHROPIC_SMALL_FAST_MODEL="auto"
