# Copy to /opt/tg-bridge/.env and chmod 600. NEVER commit the real file.
TG_API_ID=32490345
# Get api_hash at https://my.telegram.org -> API development tools
TG_API_HASH=
# Bearer token for the HTTP API; install.sh generates one (openssl rand -hex 32)
TG_BRIDGE_TOKEN=
TG_SESSION_FILE=/opt/tg-bridge/session.txt
TG_AUDIT_LOG=/opt/tg-bridge/audit.log
TG_LISTEN_HOST=127.0.0.1
TG_LISTEN_PORT=8080
TG_SEND_RATE_LIMIT=20
TG_SEND_RATE_WINDOW=60
